# Do not commit real credentials.
# Preferred for a deployed MCP server:
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional. Modal also supports OAuth credentials through its standard env vars.
# MODAL_OAUTH_REFRESH_TOKEN=
# MODAL_OAUTH_CLIENT_ID=
# MODAL_OAUTH_CLIENT_SECRET=

MODAL_PLUGIN_DEFAULT_ENVIRONMENT=dev
MODAL_PLUGIN_DATA_DIR=.modal-plugin
MODAL_PLUGIN_TRANSPORT=stdio
MODAL_PLUGIN_HOST=127.0.0.1
MODAL_PLUGIN_PORT=8000
