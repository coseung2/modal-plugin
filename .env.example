# Do not commit real credentials.

# Local Codex fallback: standard Modal credentials are still supported.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

MODAL_PLUGIN_DEFAULT_ENVIRONMENT=dev
MODAL_PLUGIN_DATA_DIR=.modal-plugin
MODAL_PLUGIN_TRANSPORT=stdio
MODAL_PLUGIN_HOST=127.0.0.1
MODAL_PLUGIN_PORT=8000

# Required for persistent account linking. Generate with:
#   uv run modal-plugin --generate-credential-key
MODAL_PLUGIN_CREDENTIAL_KEY=

# Required when the HTTP server is reachable at a public URL.
# Example: https://modal-plugin.example.com
MODAL_PLUGIN_PUBLIC_BASE_URL=
MODAL_PLUGIN_ACCOUNT_LINK_TTL_SECONDS=600

# App-level credentials issued by Modal for a third-party OAuth integration.
# These are NOT a user's refresh token.
MODAL_PLUGIN_MODAL_OAUTH_CLIENT_ID=
MODAL_PLUGIN_MODAL_OAUTH_CLIENT_SECRET=
