# Do not commit real credentials.

# Local Codex fallback: standard Modal credentials are still supported for the local owner.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

MODAL_PLUGIN_DEFAULT_ENVIRONMENT=dev
MODAL_PLUGIN_DATA_DIR=.modal-plugin
MODAL_PLUGIN_TRANSPORT=stdio
MODAL_PLUGIN_HOST=127.0.0.1
MODAL_PLUGIN_PORT=8000

# Required for persistent Modal account linking. Generate with:
#   uv run modal-plugin --generate-credential-key
MODAL_PLUGIN_CREDENTIAL_KEY=

# Public origin of the MCP service. The protected resource is <base>/mcp.
# Example: https://modal-plugin.example.com
MODAL_PLUGIN_PUBLIC_BASE_URL=
MODAL_PLUGIN_ACCOUNT_LINK_TTL_SECONDS=600

# Remote MCP OAuth resource-server configuration.
# The authorization server must expose OAuth/OIDC metadata, support PKCE for ChatGPT,
# and issue JWT access tokens whose aud/resource is MODAL_PLUGIN_PUBLIC_BASE_URL + /mcp.
MODAL_PLUGIN_OAUTH_ISSUER_URL=
MODAL_PLUGIN_OAUTH_JWKS_URL=
MODAL_PLUGIN_OAUTH_SCOPES=modal:manage
MODAL_PLUGIN_OAUTH_ALGORITHMS=RS256

# Never enable on an Internet-facing deployment. Allows unauthenticated HTTP for local testing only.
MODAL_PLUGIN_ALLOW_INSECURE_HTTP=false

# App-level credentials issued by Modal for a third-party Modal OAuth integration.
# These are NOT the ChatGPT/MCP OAuth credentials and NOT a user's refresh token.
MODAL_PLUGIN_MODAL_OAUTH_CLIENT_ID=
MODAL_PLUGIN_MODAL_OAUTH_CLIENT_SECRET=
